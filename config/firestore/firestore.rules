// [IMPORTANTE] NO DESPLEGAR DESDE ESTE REPO.
// EL DESPLIEGUE CANÓNICO DE REGLAS SE REALIZA DESDE EL PROYECTO BrixoPanelAdministrativo.
// Este archivo sirve como referencia de las reglas que aplican a los paths operativos de Farmadon.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- ÁREA GLOBAL BRIXO (Solo Lectura para Farmadon) ---
    // Paths administrados por BrixoPanel que Farmadon consume.
    match /compartido/ecosistema/{document=**} {
      allow read: if request.auth != null;
    }

    // Historial de tiempo de solicitudes (escritura desde Farmadon durante el registro/corrección)
    match /brixo/panel/historialdetiemposolicitudes/{autoId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // Lista negra: SOLO el panel la lee (PII). Farmadon consulta las tarjetas de existencia.
    match /brixo/clientes_restringidos/lista_negra/{doc} {
      allow get: if false;
      allow list: if false;
      allow write: if false;
    }

    // Tarjetas de existencia (Fase B): solo sí/no, sin PII. Lectura anónima por id.
    match /brixo/existencia/clientes/{ruc} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }
    match /brixo/existencia/restringidos/{doc} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    // Cola de idempotencia para transacciones críticas
    match /processed_requests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // --- ÁREA OPERATIVA FARMADON (v2026) ---
    // Aislamiento estricto por UID para perfiles y sesiones.

    // Perfiles de empleados: solo el propio usuario puede leer/escribir.
    match /farmaciapp/app/usuarios_farmacia/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Solicitudes de acceso: vinculadas al ID de solicitud (documento).
    match /farmaciapp/app/solicitudes/{solId} {
      allow create: if request.auth == null;
      allow get: if true;
      allow list: if false;
      allow update: if request.auth == null;
      allow delete: if false;
    }

    // Índice único de correo (RUC como ID + hash de email) - get sin list para unicidad
    match /farmaciapp/app/correos/{hash} {
      allow get: if true;
      allow create: if true;
      allow list: if false;
      allow update, delete: if false;
    }

    // Sesiones únicas: controladas por UID.
    match /farmaciapp/app/sesiones/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Colecciones de validación (Solo Lectura)
    match /farmaciapp/app/documentos/{doc} {
      allow read: if request.auth != null;
    }

    // Datos maestros de la farmacia cliente (Solo Lectura con Auth).
    // Fase B: get anónimo CERRADO. "¿ya es cliente?" se consulta en la tarjeta
    // brixo/existencia/clientes/{RUC} (solo sí/no, sin PII).
    match /farmaciapp/app/clientes/{clienteId} {
      allow get: if request.auth != null;
      allow list: if false;
      allow write: if request.auth != null;
    }

    // Defensa en profundidad: denegado por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
